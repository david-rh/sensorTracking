# Unique identifier for this sensor instance
SENSOR_ID=sensor-1

# Starting GPS coordinates (latitude, longitude)
SENSOR_START_LAT=38.8977
SENSOR_START_LNG=-77.0365

# Kafka bootstrap server address
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# TLS truststore for Kafka SSL connection
KAFKA_SSL_TRUSTSTORE_LOCATION=/etc/remote-sensor/mykeystore.jks
KAFKA_SSL_TRUSTSTORE_PASSWORD=<PASS>
